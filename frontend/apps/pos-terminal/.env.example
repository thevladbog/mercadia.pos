# Store ID — must match a known store in the system (required)
VITE_POS_STORE_ID=store-1

# Terminal ID — must match a known terminal in the system (required)
VITE_POS_TERMINAL_ID=pos-1

# Drawer ID used for demo cash drawer operations
VITE_POS_DRAWER_ID=drawer-1

# Actor ID recorded as the operational day "opened by" actor
VITE_POS_OPENED_BY_ID=admin-1

# Fiscal device ID used for demo fiscalization
VITE_POS_FISCAL_DEVICE_ID=fiscal-1

# Demo barcode scanned by the "Start sale" quick-add flow
VITE_POS_DEMO_BARCODE=4600000000000

# Software version reported in POS terminal heartbeats
VITE_POS_SOFTWARE_VERSION=dev

# IANA store time zone for operational day date selection — leave empty to use the browser's local time zone
VITE_POS_STORE_TIME_ZONE=

# Store Edge — leave empty to use the Vite proxy (:8081) in browser dev, or the
# http://127.0.0.1:8081 default when running inside the Tauri desktop shell
# (see docs/development/tauri.md).
VITE_STORE_EDGE_URL=

# Store Edge session token — leave empty in local dev (uses interactive login)
VITE_STORE_EDGE_SESSION_TOKEN=

# Central Backend — leave empty to use the Vite proxy (:8082) in browser dev, or the
# http://127.0.0.1:8082 default when running inside the Tauri desktop shell; required for
# ?templateId= layout templates
VITE_CENTRAL_BACKEND_URL=

# Central Backend session token — leave empty in local dev (uses interactive login)
VITE_CENTRAL_SESSION_TOKEN=

# Default central layout template ID — leave empty to require ?templateId= in the URL
VITE_LAYOUT_TEMPLATE_ID=

# Hardware Agent — leave empty to use the Vite proxy (:8083) in browser dev, or the
# http://127.0.0.1:8083 default when running inside the Tauri desktop shell
VITE_HARDWARE_AGENT_URL=
