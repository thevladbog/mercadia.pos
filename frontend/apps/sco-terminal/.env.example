# Store ID — must match a known store in the system (required)
VITE_SCO_STORE_ID=store-1

# Terminal ID — must match a known terminal in the system
VITE_SCO_TERMINAL_ID=sco-1

# Layout profile terminal configuration — h (horizontal), v (vertical), or hd; unknown values
# fall back to h. See docs/sco-terminal-implementation-design.md §2.
VITE_SCO_LAYOUT_PROFILE=h

# Service actor used for the unattended boot-time login (docs/sco-terminal-implementation-design.md
# §4, Proposal A) — DEV-DEMO PLACEHOLDER ONLY. Replacing this with the real SCO auth model is
# design-doc open question 1; see the `TODO(sco-auth)` in src/auth/AuthProvider.tsx.
VITE_SCO_SERVICE_ACTOR_ID=cashier-1
VITE_SCO_SERVICE_ACTOR_PIN=1234

# Drawer ID used to open the terminal's shift — SCO is cashless (ADR-0008), so this is an opaque
# placeholder identifier only; opened with a 0 opening balance so no cash ledger entry is created.
VITE_SCO_DRAWER_ID=sco-drawer-1

# Demo barcode used by the "Scan a sample item" button (M1 has no scanner/hardware-agent
# integration yet)
VITE_SCO_DEMO_BARCODE=4600000000000

# Software version reported in SCO terminal heartbeats
VITE_SCO_SOFTWARE_VERSION=dev

# Store Edge — leave empty to use the Vite proxy (:8081) in browser dev, or the
# http://127.0.0.1:8081 default when running inside the Tauri desktop shell
# (see docs/development/tauri.md).
VITE_STORE_EDGE_URL=

# Store Edge session token — leave empty in local dev (the service actor logs in automatically)
VITE_STORE_EDGE_SESSION_TOKEN=
