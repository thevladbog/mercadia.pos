{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mercadia Senior Cashier Terminal",
  "version": "0.1.0",
  "identifier": "dev.mercadia.senior-cashier-terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mercadia Senior Cashier Terminal",
        "width": 1280,
        "height": 800,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8081 http://127.0.0.1:8083 ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
